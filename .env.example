# Copy to .env. Docker Compose reads it automatically; every value below is
# also the built-in default, so the platform starts even without a .env file.
# Never commit a real .env.

NODE_ENV=development
LOG_LEVEL=info

# Host ports
WEB_PORT=3000
API_PORT=3001
POSTGRES_HOST_PORT=5433

# Browser-facing URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Docker socket on the host that runs user apps (also right for Docker Desktop).
HOST_CONTAINER_SOCKET=/var/run/docker.sock

# User apps
APP_PORT_RANGE=8001-8050     # one host port per project; URLs are http://APP_PUBLIC_HOST:<port>
APP_PUBLIC_HOST=localhost
APP_MEMORY_MB=512            # per app
APP_CPUS=0.5                 # per app
MAX_PROJECTS=10
DEPLOY_HEALTH_TIMEOUT_SECONDS=120
BUILD_TIMEOUT_SECONDS=900   # clone + docker build
AUTO_STOP_IDLE_MINUTES=120  # stop apps without traffic for this long; 0 = never

# PostgreSQL. By default the platform uses its own postgres container (below).
# USE_SUPABASE=yes: use the hosted database below and DON'T start the local
# postgres container. Leave it empty to use the local container.
USE_SUPABASE=
# To use a hosted database (e.g. Supabase) instead, set DATABASE_URL WITHOUT a
# password and put the password in DATABASE_PASSWORD.
#DATABASE_URL=postgresql://postgres.<project-ref>@aws-1-<region>.pooler.supabase.com:5432/postgres
#DATABASE_PASSWORD=
#DATABASE_SSL=require        # disable | require | verify-full
#DATABASE_SSL_CA_FILE=       # PEM file for verify-full
#DATABASE_POOL_MAX=5         # keep low on Supabase's free tier

# Local postgres container (containers connect to host "postgres")
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=cloud_platform

# Dashboard login. Empty turns it off (local development).
ADMIN_PASSWORD=
# Signs session cookies; random per start when empty.
SESSION_SECRET=
SECURE_COOKIES=false
